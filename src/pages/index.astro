---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const email = "sn82@rice.edu";
const github = "https://github.com/stephennaboth";
const linkedin = "https://www.linkedin.com/in/stephennaboth/";
---

<Base
  title="Stephen Naboth — Ph.D. Student in Computational Applied Mathematics and Operations Research"
  description="Stephen Naboth is a Ph.D. student at Rice University researching mathematical optimization, mixed-integer nonlinear optimization, machine learning, and scientific computing."
>
  <SiteHeader active="home" />

  <main id="main-content" class="page-shell">
    <section class="hero" aria-labelledby="page-title">
      <div class="hero__copy">
        <p class="kicker">Ph.D. Student</p>
        <h1 id="page-title">Stephen Naboth</h1>
        <p class="hero__role">Computational Applied Mathematics and Operations Research</p>
        <p class="hero__institution">Rice University <span aria-hidden="true">·</span> Houston, Texas</p>
        <p class="hero__summary">
          I develop optimization algorithms and computational methods for challenging decision problems. My work focuses on mixed-integer nonlinear optimization, mathematical optimization, machine learning, and scientific computing.
        </p>
        <div class="profile-links" aria-label="Profile links">
          <a href={`mailto:${email}`}>Email</a>
          <a href="/cv/">CV</a>
          <a href={github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </div>

      <figure class="portrait">
        <img src="/profile.jpg" alt="Portrait of Stephen Naboth" width="1024" height="1024" />
      </figure>
    </section>

    <aside class="focus-band" aria-label="Current research focus">
      <strong>Current focus</strong>
      <span>Mixed-integer nonlinear optimization <span aria-hidden="true">·</span> Mathematical optimization <span aria-hidden="true">·</span> Machine learning <span aria-hidden="true">·</span> Scientific computing</span>
    </aside>

    <section id="about" class="editorial-section">
      <header class="section-label"><h2>About</h2></header>
      <div class="section-content prose">
        <p>
          I am a Ph.D. student in Computational Applied Mathematics and Operations Research at Rice University, advised by Professor Illya V. Hicks. My research focuses on mathematical optimization, mixed-integer nonlinear optimization, and machine learning. I develop computational methods—including bound tightening, convex relaxations, cutting planes, and decomposition—for challenging decision problems in energy systems, symbolic regression, and scientific computing.
        </p>
      </div>
    </section>

    <section id="research" class="editorial-section">
      <header class="section-label"><h2>Research</h2></header>
      <div class="section-content stacked-list">
        <article>
          <h3>Optimization algorithms</h3>
          <p>Mixed-integer nonlinear, stochastic, and fairness-constrained optimization.</p>
        </article>
        <article>
          <h3>Computational methods</h3>
          <p>Bound tightening, convex relaxations, cutting planes, decomposition, and branch-and-bound methods.</p>
        </article>
        <article>
          <h3>Applications</h3>
          <p>Energy systems, symbolic regression, multi-fidelity modeling, and scientific decision-making.</p>
        </article>
      </div>
    </section>

    <section id="publications" class="editorial-section">
      <header class="section-label"><h2>Publications</h2></header>
      <div class="section-content bibliography">
        <article>
          <time>In preparation</time>
          <p><strong>Naboth, S., and I. V. Hicks.</strong> “Weighted, Dynamic, and Endogenous Fairness in Mathematical Optimization.” <em>Manuscript in preparation.</em></p>
        </article>
        <article>
          <time>2022</time>
          <p><strong>Naboth, S.</strong> “A New Approach for Automatic Defect Detection via Thermal Image Processing and Deep Learning Tools.” Master’s thesis, University of L’Aquila.</p>
        </article>
      </div>
    </section>

    <section id="experience" class="editorial-section">
      <header class="section-label"><h2>Experience</h2></header>
      <div class="section-content entry-list">
        <article>
          <div class="entry-heading"><div><h3>Ph.D. Researcher</h3><p>Rice University</p></div><time>2023–Present</time></div>
          <p>Develop algorithms for mixed-integer nonlinear, stochastic, and fairness-constrained optimization. Implement and benchmark computational methods using Python, Julia, Gurobi, and SCIP.</p>
        </article>
        <article>
          <div class="entry-heading"><div><h3>AI Engineer</h3><p>Summer Engineering Innovation Program, Rice University</p></div><time>2026–Present</time></div>
          <p>Develop an AI-assisted scholarship platform using specialized language-model agents, document analysis, retrieval-augmented generation, and personalized application workflows.</p>
        </article>
      </div>
    </section>

    <section id="education" class="editorial-section">
      <header class="section-label"><h2>Education</h2></header>
      <div class="section-content education-list">
        <article><div><h3>Rice University</h3><p>Ph.D., Computational Applied Mathematics and Operations Research</p><small>Expected May 2028</small></div><time>2023–Present</time></article>
        <article><div><h3>WorldQuant University</h3><p>M.S., Financial Engineering</p></div><time>2025</time></article>
        <article><div><h3>University of L’Aquila</h3><p>M.S., Mathematical Modelling</p></div><time>2022</time></article>
        <article><div><h3>University of Nairobi</h3><p>B.S., Mathematics</p></div><time>2018</time></article>
      </div>
    </section>

    <section id="service" class="editorial-section">
      <header class="section-label"><h2>Service</h2></header>
      <div class="section-content entry-list">
        <article>
          <div class="entry-heading"><div><h3>CMOR Department Representative</h3><p>Rice University Graduate Student Association</p></div><time>2025–2026</time></div>
          <p>Represented CMOR graduate students and supported initiatives in graduate engagement, professional development, and academic experience.</p>
        </article>
      </div>
    </section>

    <section class="editorial-section">
      <header class="section-label"><h2>Writing</h2></header>
      <div class="section-content writing-list">
        <article>
          <p class="post-meta"><time datetime="2026-08-07">August 7, 2026</time> · Optimization</p>
          <h3><a href="/blog/why-variable-bounds-matter/">Why variable bounds matter in mixed-integer nonlinear optimization</a></h3>
          <p>A practical introduction to how stronger variable bounds improve relaxations, computation, and model reliability.</p>
        </article>
        <article>
          <p class="post-meta"><time datetime="2026-07-24">July 24, 2026</time> · Scientific Computing</p>
          <h3><a href="/blog/reproducible-optimization-experiments/">A checklist for reproducible optimization experiments</a></h3>
          <p>Simple habits that make computational results easier to inspect, compare, and reproduce.</p>
        </article>
        <a class="text-link" href="/blog/">View all notes →</a>
      </div>
    </section>

    <section id="contact" class="editorial-section contact-section">
      <header class="section-label"><h2>Contact</h2></header>
      <div class="section-content prose">
        <p>I welcome conversations about research, collaboration, internships, and applied optimization projects.</p>
        <div class="profile-links">
          <a href={`mailto:${email}`}>{email}</a>
          <a href={github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="/cv/">CV</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
